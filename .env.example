# =====================================================================
#  PAPO - Arquivo de exemplo de variáveis de ambiente
#  Copie este arquivo para ".env" e preencha com seus valores reais.
# =====================================================================

# ---- BANCO DE DADOS (TURSO) ----
# Sem preencher: o app usa um arquivo local (data/papo.db) — ok para
# testar na sua máquina, mas os dados se perdem em hosts com disco
# efêmero (ex: Render free tier a cada deploy/dormida).
# Preenchendo as duas linhas abaixo: o app usa seu banco no Turso
# (gratuito), que sobrevive a qualquer deploy/reinício do host.
# Como conseguir esses valores: veja a seção "BANCO DE DADOS (TURSO)"
# no README.txt.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- CHAVES VAPID PARA NOTIFICAÇÕES PUSH ----
# SE VOCÊ JÁ TEM data/vapid.json, PODE DEIXAR VAZIO ABAIXO (o app migra elas automaticamente).
# Se não tiver, gere novas rodando o servidor uma vez com JSON e depois copie aqui.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# E-mail de contato do VAPID (usado no header do push, pode deixar assim)
PUSH_MAILTO=mailto:contato@papo.local

# Porta do servidor (deixe 3000 se não souber)
PORT=3000

# ---- PARA O APP DESKTOP ELECTRON ----
# URL do servidor quando o app estiver rodando em nuvem (deixe vazio para usar local)
PUBLIC_SERVER_URL=
